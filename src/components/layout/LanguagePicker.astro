---
// src/components/layout/LanguagePicker.astro
import { languages, type Lang } from '../../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

interface Props {
  className?: string;
  dropdownAlign?: 'left' | 'right';
}

const { className = '', dropdownAlign = 'right' } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
const currentPathname = Astro.url.pathname;

const langFlags: Record<Lang, string> = {
  en: '🇺🇸',
  es: '🇪🇸',
  ja: '🇯🇵',
  fr: '🇫🇷',
  de: '🇩🇪',
  pt: '🇧🇷',
  ko: '🇰🇷',
  it: '🇮🇹',
};
---

<div class={`relative inline-block text-left language-picker-root ${className}`}>
  <!-- Toggle Button -->
  <button
    type="button"
    class="lang-dropdown-btn inline-flex items-center gap-2 rounded-lg border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-2.5 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:border-black/20 dark:hover:border-white/20 hover:text-black dark:hover:text-white transition-all cursor-pointer shadow-xs active:scale-95"
    aria-expanded="false"
    aria-haspopup="true"
    title="Change language"
  >
    <span class="text-sm shrink-0">{langFlags[currentLang] || '🌐'}</span>
    <span class="font-mono text-xs uppercase tracking-wider font-bold">{currentLang}</span>
    <svg class="h-3.5 w-3.5 text-slate-400 dark:text-slate-500 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    class={`lang-dropdown-menu hidden absolute top-full mt-2 w-48 rounded-xl border border-black/10 dark:border-white/10 bg-white dark:bg-[#0e131f] p-1.5 shadow-2xl backdrop-blur-xl z-50 transition-all ${
      dropdownAlign === 'left' ? 'left-0' : 'right-0'
    }`}
    role="menu"
    aria-orientation="vertical"
  >
    <div class="px-2.5 py-1.5 border-b border-black/8 dark:border-white/8 mb-1">
      <span class="font-mono text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold">
        Select Language
      </span>
    </div>

    <div class="space-y-0.5">
      {Object.entries(languages).map(([code, label]) => {
        const langCode = code as Lang;
        const targetHref = translatePath(currentPathname, langCode);
        const isActive = langCode === currentLang;

        return (
          <a
            href={targetHref}
            role="menuitem"
            class={`flex items-center justify-between rounded-lg px-2.5 py-2 text-xs transition-colors no-underline ${
              isActive
                ? 'bg-sky-500/10 text-sky-600 dark:text-sky-400 font-bold'
                : 'text-slate-700 dark:text-slate-300 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white'
            }`}
          >
            <span class="flex items-center gap-2">
              <span class="text-sm">{langFlags[langCode]}</span>
              <span>{label}</span>
            </span>
            {isActive && (
              <svg class="h-3.5 w-3.5 text-sky-600 dark:text-sky-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            )}
          </a>
        );
      })}
    </div>
  </div>
</div>

<script>
  function setupLanguagePickers() {
    const pickers = document.querySelectorAll('.language-picker-root');

    pickers.forEach((picker) => {
      const btn = picker.querySelector('.lang-dropdown-btn') as HTMLButtonElement | null;
      const menu = picker.querySelector('.lang-dropdown-menu') as HTMLElement | null;
      const arrow = btn?.querySelector('svg');

      if (!btn || !menu) return;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = !menu.classList.contains('hidden');

        // Close all other language menus first
        document.querySelectorAll('.lang-dropdown-menu').forEach((m) => {
          if (m !== menu) m.classList.add('hidden');
        });

        if (isOpen) {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          arrow?.classList.remove('rotate-180');
        } else {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          arrow?.classList.add('rotate-180');
        }
      });
    });

    // Close when clicking outside or pressing Escape
    document.addEventListener('click', () => {
      document.querySelectorAll('.lang-dropdown-menu').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('.lang-dropdown-btn').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        b.querySelector('svg')?.classList.remove('rotate-180');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.lang-dropdown-menu').forEach((m) => m.classList.add('hidden'));
        document.querySelectorAll('.lang-dropdown-btn').forEach((b) => {
          b.setAttribute('aria-expanded', 'false');
          b.querySelector('svg')?.classList.remove('rotate-180');
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupLanguagePickers);
</script>
