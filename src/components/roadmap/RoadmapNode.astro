---
import type { RoadmapNode as RoadmapNodeType } from '../../data/roadmaps/types';

interface Props {
  node: RoadmapNodeType;
  roadmapSlug: string;
}

const { node, roadmapSlug } = Astro.props;

const difficultyColors: Record<string, string> = {
  'Beginner': 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-900/60',
  'Intermediate': 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-900/60',
  'Advanced': 'bg-purple-50 text-purple-700 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-900/60'
};
---

<div 
  class="group relative rounded-xl border border-[#ebebeb] bg-white p-5 shadow-xs transition-all hover:border-neutral-400 hover:shadow-md cursor-pointer node-container dark:border-[#27272a] dark:bg-[#121215] dark:hover:border-neutral-500"
  data-node-id={node.id}
  data-roadmap-slug={roadmapSlug}
  data-hours={node.estimatedHours}
  data-title={node.title}
  data-category={node.category}
  data-tags={JSON.stringify(node.tags)}
>
  <!-- Top Meta Bar -->
  <div class="flex items-center justify-between gap-2 mb-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-[11px] font-semibold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">
        {node.category}
      </span>
      <span class="text-neutral-300 dark:text-neutral-700">•</span>
      <span class={`rounded-full border px-2 py-0.5 font-mono text-[10px] font-medium ${difficultyColors[node.difficulty] || 'bg-neutral-50 text-neutral-600 border-neutral-200 dark:bg-neutral-900 dark:text-neutral-300 dark:border-neutral-800'}`}>
        {node.difficulty}
      </span>
      <!-- Diagnostic Personalized Tag Badge -->
      <span class="diagnostic-badge hidden rounded-full px-2 py-0.5 font-mono text-[10px] font-bold"></span>
    </div>

    <!-- Status Button (Interactive LocalStorage) -->
    <button 
      type="button" 
      class="status-toggle-btn flex items-center gap-1.5 rounded-[6px] border border-[#ebebeb] bg-neutral-50 px-2 py-1 text-[11px] font-mono text-neutral-600 hover:bg-neutral-100 dark:border-[#27272a] dark:bg-[#18181b] dark:text-neutral-300 dark:hover:bg-[#222226] transition-colors"
      title="Click to cycle status: Not Started → In Progress → Mastered"
      data-action="toggle-status"
      data-node-id={node.id}
    >
      <span class="status-indicator h-2 w-2 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
      <span class="status-text font-medium">Not Started</span>
    </button>
  </div>

  <!-- Main Node Title -->
  <h4 class="font-sans text-base font-semibold text-[#171717] dark:text-white tracking-tight mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
    {node.title}
  </h4>

  <!-- Description -->
  <p class="text-xs leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] mb-4 line-clamp-2">
    {node.shortDescription}
  </p>

  <!-- Tags & Resources Quick Count -->
  <div class="flex flex-wrap items-center justify-between pt-3 border-t border-neutral-100 dark:border-[#27272a] text-xs">
    <div class="flex items-center gap-2 text-neutral-400 dark:text-neutral-500 font-mono text-[11px]">
      <span>⏱️ ~{node.estimatedHours}h</span>
      <span>•</span>
      <span class="text-neutral-600 dark:text-neutral-300 font-medium">{node.resources.length} Elite Resources</span>
    </div>

    <button 
      type="button"
      class="open-drawer-btn text-xs font-mono font-medium text-[#171717] dark:text-white hover:text-blue-600 dark:hover:text-blue-400 underline decoration-neutral-300 dark:decoration-neutral-600 underline-offset-4 transition-colors"
      data-node-id={node.id}
    >
      Explore Resources →
    </button>
  </div>
</div>
