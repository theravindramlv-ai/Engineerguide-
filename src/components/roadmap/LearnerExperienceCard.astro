---
import type { LearnerExperience } from '../../data/roadmaps/types';

interface Props {
  experience: LearnerExperience;
  phaseNumber: number;
}

const { experience, phaseNumber } = Astro.props;

// Visual mood styling based on emotional state
const stateBadges: Record<string, { bg: string; text: string; border: string; icon: string }> = {
  'The Wall of Abstraction': { bg: 'bg-amber-50 dark:bg-amber-950/40', text: 'text-amber-800 dark:text-amber-300', border: 'border-amber-200 dark:border-amber-800/60', icon: '⚡' },
  'Tutorial Hell & Confusion': { bg: 'bg-rose-50 dark:bg-rose-950/40', text: 'text-rose-800 dark:text-rose-300', border: 'border-rose-200 dark:border-rose-800/60', icon: '🌀' },
  'The Aha! Breakthrough': { bg: 'bg-emerald-50 dark:bg-emerald-950/40', text: 'text-emerald-800 dark:text-emerald-300', border: 'border-emerald-200 dark:border-emerald-800/60', icon: '💡' },
  'Engineering Fluency': { bg: 'bg-indigo-50 dark:bg-indigo-950/40', text: 'text-indigo-800 dark:text-indigo-300', border: 'border-indigo-200 dark:border-indigo-800/60', icon: '🚀' },
  'Autonomous Architect': { bg: 'bg-purple-50 dark:bg-purple-950/40', text: 'text-purple-800 dark:text-purple-300', border: 'border-purple-200 dark:border-purple-800/60', icon: '🔮' },
  'The Initial Euphoria': { bg: 'bg-blue-50 dark:bg-blue-950/40', text: 'text-blue-800 dark:text-blue-300', border: 'border-blue-200 dark:border-blue-800/60', icon: '✨' }
};

const badgeStyle = stateBadges[experience.emotionalState] || stateBadges['The Wall of Abstraction'];
---

<div class="my-8 overflow-hidden rounded-2xl border border-[#ebebeb] bg-white shadow-sm transition-all hover:shadow-md dark:border-[#27272a] dark:bg-[#121215]">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between border-b border-[#ebebeb] bg-neutral-50/70 px-5 py-3.5 dark:border-[#27272a] dark:bg-[#18181b]/70">
    <div class="flex items-center gap-2.5">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-neutral-200 font-mono text-xs font-semibold text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
        {phaseNumber}
      </span>
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
        Learner Experience Window
      </span>
    </div>

    <div class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs font-medium ${badgeStyle.bg} ${badgeStyle.text} ${badgeStyle.border}`}>
      <span>{badgeStyle.icon}</span>
      <span>{experience.emotionalState}</span>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-6">
    <!-- Overview Feeling -->
    <div class="mb-5">
      <h4 class="font-sans text-lg font-semibold text-[#171717] dark:text-white tracking-tight mb-2">
        What you're experiencing: <span class="font-normal italic text-neutral-600 dark:text-neutral-400">"{experience.phaseName}"</span>
      </h4>
      <p class="text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
        {experience.feelingSummary}
      </p>
    </div>

    <!-- Typical Quotes / Internal Monologue -->
    <div class="mb-6 rounded-xl border border-dashed border-neutral-200 bg-neutral-50/60 p-4 dark:border-[#27272a] dark:bg-[#18181b]/60">
      <div class="mb-2 font-mono text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        What your internal monologue sounds like right now:
      </div>
      <div class="space-y-2">
        {experience.internalMonologue.map((quote) => (
          <div class="flex items-start gap-2.5 text-xs text-neutral-700 dark:text-neutral-300 italic">
            <span class="text-neutral-400 dark:text-neutral-600 font-serif text-sm">“</span>
            <span class="flex-1">{quote.replace(/^"|"$/g, '')}</span>
            <span class="text-neutral-400 dark:text-neutral-600 font-serif text-sm">”</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Two-column: What's Actually Happening vs How To Survive -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 pt-2 border-t border-neutral-100 dark:border-[#27272a]">
      <!-- Col 1: The Brain Mechanism -->
      <div>
        <div class="flex items-center gap-1.5 mb-2">
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-indigo-950 dark:text-indigo-300">
            Neurobiology of this stage
          </span>
        </div>
        <p class="text-xs leading-relaxed text-neutral-600 dark:text-neutral-400 mb-3">
          {experience.whatIsActuallyHappening}
        </p>

        <div class="rounded-lg bg-amber-50/70 border border-amber-100 p-3 dark:bg-amber-950/30 dark:border-amber-900/50">
          <span class="font-mono text-[11px] font-semibold text-amber-900 dark:text-amber-300 block mb-1">
            ⚠️ Pitfall to dodge:
          </span>
          <ul class="list-disc list-inside space-y-1 text-xs text-amber-800 dark:text-amber-200">
            {experience.commonPitfalls.map((pitfall) => (
              <li>{pitfall}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Col 2: Actionable Survival Advice -->
      <div class="flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-1.5 mb-2">
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-emerald-950 dark:text-emerald-300">
              Sanity Check & Breakthrough Tactic
            </span>
          </div>
          <div class="rounded-lg bg-emerald-50/70 border border-emerald-100 p-4 text-xs leading-relaxed text-emerald-900 dark:bg-emerald-950/30 dark:border-emerald-900/50 dark:text-emerald-200">
            {experience.survivalAdvice}
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between text-[11px] font-mono text-neutral-400 dark:text-neutral-500 border-t border-neutral-100 dark:border-[#27272a] pt-3">
          <span>Remember: Discomfort is evidence of synaptic adaptation.</span>
          <span class="text-neutral-500 dark:text-neutral-400 font-medium">Keep coding →</span>
        </div>
      </div>
    </div>
  </div>
</div>
