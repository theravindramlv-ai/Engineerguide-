          <span>FREQUENTLY ASKED QUESTIONS</span>
        </div>
        <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-950 dark:text-white tracking-tight">
          Everything you need to know about engineering roadmaps.
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
          Clear answers about choosing a branch, mastering foundational skills, preparing for internships, and leveraging free canonical curricula.
        </p>

        <!-- Live FAQ Search Filter -->
        <div class="mt-8 max-w-md mx-auto">
          <div class="relative">
            <input
              id="faq-search-input"
              type="text"
              placeholder="Search 20 common engineering questions..."
              class="w-full rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-4 py-2.5 pl-10 text-xs text-slate-950 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 outline-none focus:border-sky-500 dark:focus:border-sky-400/50 transition-colors shadow-xs"
            />
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400 dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- FAQ Accordion List -->
      <div class="space-y-3.5" id="faq-accordion-list">
        {faqs.map((faq, index) => (
          <details 
            class="faq-item hairline-card group p-5 transition-all overflow-hidden cursor-pointer"
            data-question={faq.question.toLowerCase()}
            data-answer={faq.answer.toLowerCase()}
          >
            <summary class="flex items-center justify-between gap-4 font-sans text-base font-bold text-slate-900 dark:text-white list-none select-none">
              <span class="flex items-center gap-3">
                <span class="font-mono text-xs text-sky-600 dark:text-sky-400 font-semibold bg-sky-500/10 px-2 py-0.5 rounded-md border border-sky-500/20 shrink-0">
                  {index + 1 < 10 ? `0${index + 1}` : index + 1}
                </span>
                <span class="group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                  {faq.question}
                </span>
              </span>
              <svg 
                class="w-5 h-5 text-slate-400 group-hover:text-sky-500 transition-transform duration-200 shrink-0 group-open:rotate-180" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="pt-4 mt-3 border-t border-black/5 dark:border-white/8 text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>

      <!-- Empty State for FAQ Search -->
      <div id="faq-empty-state" class="hidden text-center py-12">
        <p class="text-sm font-mono text-slate-500 dark:text-slate-400">
          No questions found matching your search. Try searching for "software", "internship", "projects", or "degree".
        </p>
      </div>

      <!-- Quick Assistance Callout -->
      <div class="mt-12 p-6 rounded-2xl border border-sky-500/20 bg-sky-500/5 dark:bg-sky-500/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500/20 text-sky-600 dark:text-sky-400 font-mono text-lg font-bold shrink-0">
            🎯
          </div>
          <div>
            <h4 class="font-sans text-sm font-bold text-slate-950 dark:text-white">Discover My Skill Level</h4>
            <p class="text-xs text-slate-600 dark:text-slate-400">Take a short practical assessment to discover your current engineering skills and find your highest-impact learning gaps.</p>
          </div>
        </div>
        <button
          type="button"
          class="open-personalizer-trigger shrink-0 rounded-xl bg-sky-500 hover:bg-sky-600 px-5 py-2.5 font-sans text-xs font-semibold text-white shadow-xs transition-all cursor-pointer active:scale-95"
        >
          Start Diagnostic →
        </button>
      </div>
    </div>
  </section>

  <!-- 7. Bottom Banner / CTA -->
  <section class="bg-[var(--bg-primary)] py-16 sm:py-24 text-center transition-colors">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-sans text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white mb-4">
        Ready to start your engineering path?
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 mb-8 max-w-xl mx-auto">
        Join students and engineers learning with canonical MIT and Stanford curricula — zero paywalls, zero ads.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/roadmaps"
          class="rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 px-8 py-3.5 font-sans text-sm font-semibold text-white shadow-md shadow-sky-500/20 hover:opacity-95 transition-all active:scale-95 no-underline"
        >
          Explore All 26 Roadmaps →
        </a>
        <button
          type="button"
          class="open-personalizer-trigger rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-8 py-3.5 font-sans text-sm font-semibold text-slate-800 dark:text-slate-200 hover:border-black/20 dark:hover:border-white/20 hover:bg-black/10 dark:hover:bg-white/10 hover:text-black dark:hover:text-white transition-all cursor-pointer"
        >
          Discover My Skill Level
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupHomeInteractions() {
    // 1. Branch Filtering
    const searchInput = document.getElementById('branch-search-home') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll('.category-tab-btn');
    const cards = document.querySelectorAll('#home-branches-grid > a');

    let activeCat = 'all';
    let searchQuery = '';

    function filterBranches() {
      cards.forEach((card) => {
        const c = card as HTMLElement;
        const cat = c.getAttribute('data-cat') || '';
        const search = c.getAttribute('data-search') || '';

        const matchesCat = activeCat === 'all' || cat === activeCat;
        const matchesSearch = !searchQuery || search.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterBranches();
    });

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.className = 'category-tab-btn rounded-xl border px-4 py-2 text-xs font-semibold font-sans transition-all cursor-pointer bg-black/5 dark:bg-white/5 text-slate-700 dark:text-slate-300 border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover:text-black dark:hover:text-white';
        });
        btn.className = 'category-tab-btn rounded-xl border px-4 py-2 text-xs font-semibold font-sans transition-all cursor-pointer bg-slate-900 text-white dark:bg-white dark:text-slate-950 border-slate-900 dark:border-white font-bold';

        activeCat = btn.getAttribute('data-cat') || 'all';
        filterBranches();
      });
    });

    // 2. FAQ Live Search
    const faqSearchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const faqItems = document.querySelectorAll('.faq-item');
    const faqEmptyState = document.getElementById('faq-empty-state');

    faqSearchInput?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      let visibleCount = 0;

      faqItems.forEach((item) => {
        const el = item as HTMLElement;
        const questionText = el.getAttribute('data-question') || '';
        const answerText = el.getAttribute('data-answer') || '';

        if (!q || questionText.includes(q) || answerText.includes(q)) {
          el.classList.remove('hidden');
          visibleCount++;
          // If searching with 3+ characters, automatically expand matching items for immediate reading
          if (q.length >= 3 && (questionText.includes(q) || answerText.includes(q))) {
            (el as HTMLDetailsElement).open = true;
          }
        } else {
          el.classList.add('hidden');
        }
      });

      if (faqEmptyState) {
        if (visibleCount === 0) {
          faqEmptyState.classList.remove('hidden');
        } else {
          faqEmptyState.classList.add('hidden');
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupHomeInteractions);
</script>
