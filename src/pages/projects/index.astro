---
// src/pages/projects/index.astro
// Portfolio engineering projects directory
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { projectCategories } from '../../data/projects';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Projects', item: '/projects' },
];
---

<Layout
  title="Engineering Portfolio Projects for Students & Developers | EngineerGuide"
  description="Explore vetted, portfolio-grade engineering project specifications across full-stack web development, AI/ML pipelines, cloud infrastructure, and student starters."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Header -->
  <section class="relative overflow-hidden border-b border-black/8 dark:border-white/8 bg-[var(--bg-primary)] pt-14 pb-16 sm:pt-20 sm:pb-22 bg-grid-subtle transition-colors">
    <div class="hero-radial-glow absolute inset-0 -top-20 h-[550px] w-full pointer-events-none"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-4 flex justify-center">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <div class="inline-flex items-center gap-2 rounded-full border border-sky-500/20 bg-sky-500/5 dark:bg-sky-500/10 px-4 py-1.5 text-xs font-mono font-medium text-sky-600 dark:text-sky-400 mb-5 shadow-xs">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
        <span class="tracking-wider uppercase">Proof of Competence · No Tutorial Clones</span>
      </div>

      <h1 class="font-sans text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white leading-tight mb-4">
        Engineering Portfolio Projects
      </h1>

      <p class="mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-400 mb-8 font-normal">
        Break free from tutorial hell. Build production-grade systems with architectural specifications, edge-case handling, and clear technical interview talking points.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-slate-500 dark:text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="text-sky-500">✓</span> Real Architectural Tradeoffs
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-sky-500">✓</span> Database & State Persistence
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-sky-500">✓</span> Resume-Ready Features
        </span>
      </div>
    </div>
  </section>

  <!-- Project Categories Grid -->
  <section class="bg-[var(--bg-surface)] py-14 sm:py-20 border-b border-black/8 dark:border-white/8 transition-colors">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="font-sans text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white tracking-tight mb-3">
          Select Your Focus Domain
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Each project category includes feature specifications, recommended architecture patterns, and extensions to demonstrate seniority.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {projectCategories.map((cat) => (
          <div class="hairline-card p-8 rounded-2xl flex flex-col justify-between hover:border-sky-500/40 transition-all group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
                  {cat.badge}
                </span>
                <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                  {cat.projects.length} Detailed {cat.projects.length === 1 ? 'Spec' : 'Specs'}
                </span>
              </div>

              <h3 class="font-sans text-xl font-bold text-slate-950 dark:text-white leading-snug mb-2 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                {cat.name}
              </h3>

              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                {cat.tagline}
              </p>

              <div class="space-y-3 mb-6">
                <span class="font-mono text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500 block">
                  Featured Specifications:
                </span>
                {cat.projects.map((proj) => (
                  <div class="p-3 rounded-xl border border-black/5 dark:border-white/5 bg-black/5 dark:bg-white/5">
                    <div class="flex items-center justify-between gap-2">
                      <span class="font-sans text-xs font-bold text-slate-900 dark:text-white">
                        {proj.title}
                      </span>
                      <span class="font-mono text-[10px] text-slate-500">
                        {proj.difficulty}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-6 border-t border-black/8 dark:border-white/8 flex items-center justify-between">
              <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                Coupled with {cat.relatedRoadmapName}
              </span>
              <a
                href={`/projects/${cat.slug}`}
                class="rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-950 px-4 py-2 font-sans text-xs font-bold hover:bg-slate-800 dark:hover:bg-slate-200 transition-colors no-underline flex items-center gap-1.5"
              >
                <span>View All Specs</span>
                <span class="font-mono">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-link back to roadmaps -->
  <section class="py-14 bg-[var(--bg-primary)] transition-colors">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-sans text-xl font-bold text-slate-950 dark:text-white mb-3">
        Need to learn the foundations before building?
      </h2>
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-6 max-w-xl mx-auto">
        Follow our structured, stage-by-stage roadmaps to build the prerequisite skills before tackling portfolio projects.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/roadmaps"
          class="rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-sans text-xs font-semibold text-white shadow-md shadow-sky-500/20 hover:opacity-95 transition-all no-underline"
        >
          Explore All Roadmaps →
        </a>
        <a
          href="/resources"
          class="rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-6 py-3 font-sans text-xs font-semibold text-slate-900 dark:text-white hover:bg-black/10 dark:hover:bg-white/10 transition-all no-underline"
        >
          Browse Free Resources
        </a>
      </div>
    </div>
  </section>
</Layout>
