---
import Layout from '../../../layouts/Layout.astro';
import { allBranches } from '../../../data/branches';
import { useTranslations, useTranslatedPath, type Lang } from '../../../i18n/utils';

export async function getStaticPaths() {
  return ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as Lang;
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const categories = [
  { id: 'all', label: t('branches.catAll'), count: allBranches.length },
  { id: 'technology', label: t('branches.catTech'), count: allBranches.filter(b => b.category === 'technology').length },
  { id: 'traditional', label: t('branches.catTrad'), count: allBranches.filter(b => b.category === 'traditional').length },
  { id: 'emerging', label: t('branches.catEmerg'), count: allBranches.filter(b => b.category === 'emerging').length },
];
---

<Layout
  title={`${t('roadmaps.directoryTitle')} — EngineerGuide`}
  description={t('roadmaps.directorySubtitle')}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden border-b border-black/8 dark:border-white/8 bg-[var(--bg-primary)] pt-14 pb-16 sm:pt-20 sm:pb-22 bg-grid-subtle transition-colors">
    <div class="hero-radial-glow absolute inset-0 -top-20 h-[550px] w-full"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumb -->
      <div class="flex items-center justify-center gap-2 mb-4 font-mono text-xs text-slate-500 dark:text-slate-400">
        <a href={translatePath('/')} class="hover:text-slate-950 dark:hover:text-white transition-colors no-underline">
          {currentLang === 'es' ? 'Inicio' : currentLang === 'ja' ? 'ホーム' : currentLang === 'fr' ? 'Accueil' : currentLang === 'de' ? 'Startseite' : currentLang === 'pt' ? 'Início' : currentLang === 'ko' ? '홈' : currentLang === 'it' ? 'Home' : 'Home'}
        </a>
        <span>/</span>
        <span class="text-slate-950 dark:text-white font-semibold">{t('nav.roadmaps')}</span>
      </div>

      <div class="inline-flex items-center gap-2 rounded-full border border-sky-500/20 bg-sky-500/5 dark:bg-sky-500/10 px-4 py-1.5 text-xs font-mono font-medium text-sky-600 dark:text-sky-400 mb-5 shadow-xs">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
        <span class="tracking-wider uppercase">{t('hero.badge')}</span>
      </div>

      <h1 class="font-sans text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white leading-tight mb-4">
        {t('roadmaps.directoryTitle')}
      </h1>

      <p class="mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-400 mb-8 font-normal">
        {t('roadmaps.directorySubtitle')}
      </p>

      <!-- Instant Search Input -->
      <div class="mx-auto max-w-xl">
        <div class="relative">
          <input
            id="roadmap-search-input"
            type="text"
            placeholder={t('roadmaps.searchPlaceholder')}
            class="w-full rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-5 py-3.5 pl-12 text-sm text-slate-950 dark:text-white shadow-xs outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-sky-500 dark:focus:border-sky-400/50 focus:ring-2 focus:ring-sky-500/10"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Roadmaps Grid Section -->
  <section class="border-b border-black/8 dark:border-white/8 bg-[var(--bg-surface)] py-14 sm:py-20 transition-colors">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10">
        <div class="flex flex-wrap gap-2" id="roadmap-cat-tabs">
          {categories.map(cat => (
            <button
              type="button"
              data-cat={cat.id}
              class={`cat-filter-btn rounded-xl border px-4 py-2 text-xs font-semibold font-sans transition-all cursor-pointer ${cat.id === 'all' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-950 border-slate-900 dark:border-white font-bold' : 'bg-black/5 dark:bg-white/5 text-slate-700 dark:text-slate-300 border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover:text-black dark:hover:text-white'}`}
            >
              {cat.label}
              <span class="ml-1.5 font-mono text-[10px] opacity-70">({cat.count})</span>
            </button>
          ))}
        </div>

        <div class="font-mono text-xs text-slate-500 dark:text-slate-400">
          {t('roadmaps.showing')} <span id="visible-count" class="font-bold text-slate-900 dark:text-white">{allBranches.length}</span> {t('roadmaps.of')} {allBranches.length} {t('roadmaps.roadmaps')}
        </div>
      </div>

      <!-- Grid of all 26 branches -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="all-roadmaps-grid">
        {allBranches.map((branch) => {
          const href = branch.hasFullRoadmap
            ? translatePath(`/roadmaps/${branch.fullRoadmapSlug}`)
            : translatePath(`/roadmaps/overview/${branch.slug}`);
          const searchData = `${branch.name} ${branch.tagline} ${branch.category}`.toLowerCase();
          return (
            <a
              href={href}
              data-cat={branch.category}
              data-search={searchData}
              class="roadmap-grid-card branch-card p-6 flex flex-col justify-between no-underline group"
            >
              <div>
                <!-- Icon + Type Badge -->
                <div class="flex items-start justify-between gap-2 mb-4">
                  <span class="text-3xl transition-transform group-hover:scale-110">{branch.emoji}</span>
                  {branch.hasFullRoadmap ? (
                    <span class="rounded-md bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20 text-[10px] font-mono px-2 py-0.5 font-semibold shrink-0">
                      Full Tree
                    </span>
                  ) : (
                    <span class="rounded-md bg-black/5 dark:bg-white/5 text-slate-500 dark:text-slate-400 border border-black/10 dark:border-white/10 text-[10px] font-mono px-2 py-0.5 font-medium shrink-0">
                      4 Stages
                    </span>
                  )}
                </div>

                <!-- Title & Tagline -->
                <h3 class="font-sans text-base font-bold text-slate-950 dark:text-white leading-snug mb-2 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                  {branch.name}
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-2">
                  {branch.tagline}
                </p>
              </div>

              <!-- Footer with Career & Link -->
              <div class="mt-6 pt-3 border-t border-black/8 dark:border-white/8 flex items-center justify-between text-xs">
                <span class="font-mono text-slate-500 dark:text-slate-400 truncate max-w-[150px] text-[11px]">
                  {branch.careers[0]?.title}
                </span>
                <span class="font-mono font-semibold text-sky-600 dark:text-sky-400 group-hover:text-sky-500 dark:group-hover:text-sky-300 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  {t('branches.explore')} →
                </span>
              </div>
            </a>
          );
        })}
      </div>

      <!-- No Results State -->
      <div id="no-roadmaps-match" class="hidden text-center py-16">
        <div class="text-4xl mb-3">🔍</div>
        <h3 class="font-sans text-xl font-bold text-slate-950 dark:text-white mb-2">{t('roadmaps.noMatchTitle')}</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-6">{t('roadmaps.noMatchSubtitle')}</p>
        <button
          id="reset-search-btn"
          type="button"
          class="rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-950 px-5 py-2 font-sans text-xs font-bold cursor-pointer hover:bg-slate-800 dark:hover:bg-slate-200 transition-colors"
        >
          {t('roadmaps.resetFilters')}
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupRoadmapsFilter() {
    const searchInput = document.getElementById('roadmap-search-input') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll('.cat-filter-btn');
    const cards = document.querySelectorAll('.roadmap-grid-card');
    const countElem = document.getElementById('visible-count');
    const noMatchElem = document.getElementById('no-roadmaps-match');
    const resetBtn = document.getElementById('reset-search-btn');

    let activeCat = 'all';
    let searchQuery = '';

    function filterCards() {
      let visible = 0;

      cards.forEach((card) => {
        const c = card as HTMLElement;
        const cardCat = c.getAttribute('data-cat') || '';
        const searchData = c.getAttribute('data-search') || '';

        const matchesCat = activeCat === 'all' || cardCat === activeCat;
        const matchesSearch = !searchQuery || searchData.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          c.classList.remove('hidden');
          visible++;
        } else {
          c.classList.add('hidden');
        }
      });

      if (countElem) countElem.textContent = visible.toString();
      if (noMatchElem) {
        if (visible === 0) noMatchElem.classList.remove('hidden');
        else noMatchElem.classList.add('hidden');
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterCards();
    });

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.className = 'cat-filter-btn rounded-xl border px-4 py-2 text-xs font-semibold font-sans transition-all cursor-pointer bg-black/5 dark:bg-white/5 text-slate-700 dark:text-slate-300 border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover:text-black dark:hover:text-white';
        });
        btn.className = 'cat-filter-btn rounded-xl border px-4 py-2 text-xs font-semibold font-sans transition-all cursor-pointer bg-slate-900 text-white dark:bg-white dark:text-slate-950 border-slate-900 dark:border-white font-bold';

        activeCat = btn.getAttribute('data-cat') || 'all';
        filterCards();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeCat = 'all';
      catButtons.forEach((b) => {
        if (b.getAttribute('data-cat') === 'all') {
          b.className = 'cat-filter-btn rounded-xl border px-4 py-2 text-xs font-semibold font-sans transition-all cursor-pointer bg-slate-900 text-white dark:bg-white dark:text-slate-950 border-slate-900 dark:border-white font-bold';
        } else {
          b.className = 'cat-filter-btn rounded-xl border px-4 py-2 text-xs font-semibold font-sans transition-all cursor-pointer bg-black/5 dark:bg-white/5 text-slate-700 dark:text-slate-300 border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover:text-black dark:hover:text-white';
        }
      });
      filterCards();
    });
  }

  document.addEventListener('DOMContentLoaded', setupRoadmapsFilter);
</script>
