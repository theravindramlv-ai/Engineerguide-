---
// src/pages/resources/index.astro
// Canonical free engineering learning resources hub
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { allResources } from '../../data/resources';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Resources', item: '/resources' },
];

const categories = ['Software Engineering', 'AI & Data', 'Cloud & DevOps', 'Foundations'] as const;
---

<Layout
  title="Free Engineering Learning Resources & Canonical Guides | EngineerGuide"
  description="Curated canonical learning resources, official documentation, and open university curriculums across software development, AI, cloud systems, and computer science foundations."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Header -->
  <section class="relative overflow-hidden border-b border-black/8 dark:border-white/8 bg-[var(--bg-primary)] pt-14 pb-16 sm:pt-20 sm:pb-22 bg-grid-subtle transition-colors">
    <div class="hero-radial-glow absolute inset-0 -top-20 h-[550px] w-full pointer-events-none"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-4 flex justify-center">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <div class="inline-flex items-center gap-2 rounded-full border border-sky-500/20 bg-sky-500/5 dark:bg-sky-500/10 px-4 py-1.5 text-xs font-mono font-medium text-sky-600 dark:text-sky-400 mb-5 shadow-xs">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
        <span class="tracking-wider uppercase">Canonical Curriculums · Zero Paywalls</span>
      </div>

      <h1 class="font-sans text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white leading-tight mb-4">
        Engineering Learning Resources
      </h1>

      <p class="mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-400 mb-8 font-normal">
        Authoritative documentation, open university lecture series, and structured interactive tutorials. Hand-selected for clarity, technical depth, and long-term durability.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-slate-500 dark:text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="text-sky-500">✓</span> Official Specs & Docs
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-sky-500">✓</span> University Curriculums
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-sky-500">✓</span> Project-Coupled Exercises
        </span>
      </div>
    </div>
  </section>

  <!-- Resources Grid by Category -->
  <section class="bg-[var(--bg-surface)] py-14 sm:py-20 border-b border-black/8 dark:border-white/8 transition-colors">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-16">
      {categories.map((cat) => {
        const topics = allResources.filter((r) => r.category === cat);
        if (topics.length === 0) return null;
        return (
          <div class="space-y-6">
            <div class="border-b border-black/8 dark:border-white/8 pb-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
              <h2 class="font-sans text-2xl font-bold text-slate-950 dark:text-white tracking-tight">
                {cat}
              </h2>
              <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                {topics.length} In-Depth Topic {topics.length === 1 ? 'Guide' : 'Guides'}
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {topics.map((topic) => (
                <a
                  href={`/resources/${topic.slug}`}
                  class="hairline-card p-6 flex flex-col justify-between no-underline group hover:border-sky-500/40 transition-all rounded-2xl"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
                        {topic.shortName}
                      </span>
                      <span class="rounded-md border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-2 py-0.5 font-mono text-[10px] text-slate-600 dark:text-slate-400">
                        {topic.difficulty}
                      </span>
                    </div>

                    <h3 class="font-sans text-lg font-bold text-slate-950 dark:text-white leading-snug mb-2 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                      {topic.title}
                    </h3>

                    <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-4">
                      {topic.description}
                    </p>

                    <div class="flex flex-wrap gap-1.5 mb-4">
                      {topic.keyConcepts.slice(0, 3).map((concept) => (
                        <span class="rounded-md bg-black/5 dark:bg-white/5 px-2 py-1 font-mono text-[10px] text-slate-600 dark:text-slate-400 border border-black/5 dark:border-white/5">
                          {concept}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="pt-4 border-t border-black/8 dark:border-white/8 flex items-center justify-between text-xs">
                    <span class="font-mono text-slate-500 dark:text-slate-400 truncate max-w-[200px]">
                      via {topic.relatedRoadmapName}
                    </span>
                    <span class="font-mono font-semibold text-sky-600 dark:text-sky-400 group-hover:text-sky-500 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                      Read Guide →
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Cross-Link Topic Silo -->
  <section class="py-14 bg-[var(--bg-primary)] transition-colors">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-sans text-xl font-bold text-slate-950 dark:text-white mb-3">
        Ready to test your knowledge with real code?
      </h2>
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-6 max-w-xl mx-auto">
        Reading documentation is only stage one. Build resume-worthy portfolio projects designed around each resource concept.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/projects"
          class="rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-sans text-xs font-semibold text-white shadow-md shadow-sky-500/20 hover:opacity-95 transition-all no-underline"
        >
          Explore Portfolio Projects →
        </a>
        <a
          href="/roadmaps"
          class="rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-6 py-3 font-sans text-xs font-semibold text-slate-900 dark:text-white hover:bg-black/10 dark:hover:bg-white/10 transition-all no-underline"
        >
          View Full Engineering Roadmaps
        </a>
      </div>
    </div>
  </section>
</Layout>
