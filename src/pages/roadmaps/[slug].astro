---
// src/pages/roadmaps/[slug].astro
// Authoritative interactive roadmap + comprehensive domain learning guide
import Layout from '../../layouts/Layout.astro';
import RoadmapTree from '../../components/roadmap/RoadmapTree.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { allRoadmaps, type Roadmap } from '../../data/roadmaps';
import { allBranches } from '../../data/branches';
import { getRoadmapGuide } from '../../data/roadmaps/seo-content';

export function getStaticPaths() {
  return allRoadmaps.map((roadmap) => ({
    params: { slug: roadmap.slug },
    props: { roadmap },
  }));
}

interface Props {
  roadmap: Roadmap;
}

const { roadmap } = Astro.props;
const guide = getRoadmapGuide(roadmap.slug);

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Roadmaps', item: '/roadmaps' },
  { name: roadmap.title, item: `/roadmaps/${roadmap.slug}` },
];

const pageTitle = guide ? `${guide.metaTitle}` : `${roadmap.title} — EngineerGuide`;
const pageDescription = guide ? guide.metaDescription : roadmap.description;
const faqs = guide ? guide.faqs : [];
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  type="article"
  articleData={{
    publishedTime: '2026-01-01T00:00:00Z',
    modifiedTime: new Date().toISOString(),
    section: roadmap.branchName,
    tags: [roadmap.branchName, 'Engineering Roadmap', 'Learning Path', roadmap.title],
  }}
>
  <!-- Roadmap Hero Section -->
  <header class="relative border-b border-black/8 dark:border-white/8 bg-[var(--bg-primary)] py-14 sm:py-20 overflow-hidden transition-colors">
    <div class="hero-radial-glow absolute inset-0 -top-20 h-[550px] w-full pointer-events-none"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <div class="mb-4">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <!-- Main Headline -->
      <h1 class="font-sans text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white leading-tight mb-4">
        {guide ? guide.h1 : roadmap.title}
      </h1>

      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-400 mb-6 font-normal">
        {guide ? guide.overview : roadmap.description}
      </p>

      <!-- Key Metrics Strip -->
      <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-black/8 dark:border-white/8 font-mono text-xs text-slate-600 dark:text-slate-400">
        <div class="flex items-center gap-1.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 px-3 py-1">
          <span class="text-slate-400 dark:text-slate-500">Total Effort:</span>
          <span class="font-bold text-slate-950 dark:text-white">~{roadmap.totalHours} Hours</span>
        </div>

        <div class="flex items-center gap-1.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 px-3 py-1">
          <span class="text-slate-400 dark:text-slate-500">Pace:</span>
          <span class="font-bold text-slate-950 dark:text-white">{roadmap.estimatedWeeks} Weeks (~12h/wk)</span>
        </div>

        <div class="flex items-center gap-1.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 px-3 py-1">
          <span class="text-slate-400 dark:text-slate-500">Rigor:</span>
          <span class="font-bold text-sky-600 dark:text-sky-400">{roadmap.difficultyLevel}</span>
        </div>

        <!-- AI Personalizer trigger on roadmap page -->
        <button 
          type="button" 
          class="open-personalizer-trigger ml-auto inline-flex items-center gap-2 rounded-full bg-slate-900 px-4 py-1.5 text-xs font-medium text-white hover:bg-slate-800 transition-all cursor-pointer shadow-xs dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200"
        >
          <svg class="h-3.5 w-3.5 text-sky-400 dark:text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Discover My Skill Level</span>
        </button>
      </div>
    </div>
  </header>

  <!-- 1. Interactive Visual Roadmap Tree (Primary Experience) -->
  <main>
    <RoadmapTree roadmap={roadmap} />
  </main>

  <!-- 2. Comprehensive Educational Domain Guide (Search Intent & Depth) -->
  {guide && (
    <article class="border-t border-black/8 dark:border-white/8 bg-[var(--bg-surface)] py-16 sm:py-24 transition-colors">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-16">
        
        <!-- Target Audience & Prerequisites -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="hairline-card p-6 sm:p-8 rounded-2xl space-y-3">
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
              AUDIENCE & FIT
            </span>
            <h2 class="font-sans text-xl font-bold text-slate-950 dark:text-white">
              Who Should Follow This Path?
            </h2>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {guide.whoShouldFollow}
            </p>
          </div>

          <div class="hairline-card p-6 sm:p-8 rounded-2xl space-y-3">
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
              FOUNDATIONAL PREREQUISITES
            </span>
            <h2 class="font-sans text-xl font-bold text-slate-950 dark:text-white">
              Required Background
            </h2>
            <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
              {guide.prerequisites.map((prereq) => (
                <li class="flex items-start gap-2">
                  <span class="text-sky-500 mt-0.5">✓</span>
                  <span>{prereq}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Stage-by-Stage Curriculum Objectives -->
        <section class="space-y-6">
          <div class="border-b border-black/8 dark:border-white/8 pb-4">
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">
              CURRICULUM BREAKDOWN
            </span>
            <h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-slate-950 dark:text-white tracking-tight">
              Stage-by-Stage Learning Milestones
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {guide.stagesBreakdown.map((stage) => (
              <div class="hairline-card p-6 rounded-2xl space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-mono text-xs font-bold text-sky-600 dark:text-sky-400">
                    STAGE {stage.stageNumber}
                  </span>
                  <span class="rounded-md border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-2 py-0.5 font-mono text-[10px] text-slate-600 dark:text-slate-400">
                    {stage.duration}
                  </span>
                </div>
                <h3 class="font-sans text-lg font-bold text-slate-950 dark:text-white">
                  {stage.title}
                </h3>
                <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                  {stage.objectives.map((obj) => (
                    <li class="flex items-start gap-2">
                      <span class="text-sky-500 mt-0.5">→</span>
                      <span>{obj}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <!-- Key Technologies with Internal Resource Links -->
        <section class="space-y-6">
          <div class="border-b border-black/8 dark:border-white/8 pb-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <div>
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">
                TOPIC CLUSTERS
              </span>
              <h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-slate-950 dark:text-white tracking-tight">
                Key Technologies & Learning Guides
              </h2>
            </div>
            <a href="/resources" class="font-mono text-xs text-sky-600 dark:text-sky-400 hover:underline">
              View All Free Resources →
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {guide.keyTechnologies.map((tech) => (
              <div class="hairline-card p-5 rounded-xl flex flex-col justify-between space-y-3">
                <div>
                  <h3 class="font-sans text-base font-bold text-slate-950 dark:text-white mb-1">
                    {tech.name}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    {tech.description}
                  </p>
                </div>
                {tech.resourceLink && (
                  <a
                    href={tech.resourceLink}
                    class="font-mono text-xs text-sky-600 dark:text-sky-400 font-semibold hover:underline flex items-center gap-1 pt-2 border-t border-black/5 dark:border-white/5"
                  >
                    <span>Read {tech.name} Guide</span>
                    <span>→</span>
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Recommended Projects with Internal Project Links -->
        <section class="space-y-6">
          <div class="border-b border-black/8 dark:border-white/8 pb-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <div>
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">
                PORTFOLIO CAPSTONES
              </span>
              <h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-slate-950 dark:text-white tracking-tight">
                Recommended Portfolio Projects
              </h2>
            </div>
            <a href="/projects" class="font-mono text-xs text-sky-600 dark:text-sky-400 hover:underline">
              View All Project Specs →
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {guide.featuredProjects.map((proj) => (
              <div class="hairline-card p-6 rounded-2xl flex flex-col justify-between space-y-4">
                <div>
                  <h3 class="font-sans text-lg font-bold text-slate-950 dark:text-white mb-2">
                    {proj.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    {proj.summary}
                  </p>
                </div>
                <div class="pt-4 border-t border-black/8 dark:border-white/8">
                  <a
                    href={`/projects/${proj.categorySlug}`}
                    class="rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 px-4 py-2 font-sans text-xs font-semibold text-slate-900 dark:text-white transition-colors no-underline inline-flex items-center gap-1.5"
                  >
                    <span>Inspect Architecture Spec</span>
                    <span class="font-mono">→</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Career Progression & Roles (Grounded, No Arbitrary Salary Claims) -->
        <section class="space-y-6">
          <div class="border-b border-black/8 dark:border-white/8 pb-4">
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">
              CAREER TRAJECTORY
            </span>
            <h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-slate-950 dark:text-white tracking-tight">
              Roles & Responsibility Milestones
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {guide.careerProgression.map((prog) => (
              <div class="hairline-card p-6 rounded-2xl space-y-3">
                <div class="font-mono text-xs font-semibold text-sky-600 dark:text-sky-400">
                  {prog.level}
                </div>
                <h3 class="font-sans text-base font-bold text-slate-950 dark:text-white">
                  {prog.role}
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                  {prog.responsibilities}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- Internship Preparation Checklist & Common Pitfalls -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="hairline-card p-6 sm:p-8 rounded-2xl space-y-4">
            <h2 class="font-sans text-xl font-bold text-slate-950 dark:text-white flex items-center gap-2">
              <span>🎯</span>
              <span>Internship Readiness Checklist</span>
            </h2>
            <ul class="space-y-2.5 text-xs text-slate-700 dark:text-slate-300">
              {guide.internshipChecklist.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="hairline-card p-6 sm:p-8 rounded-2xl space-y-4">
            <h2 class="font-sans text-xl font-bold text-slate-950 dark:text-white flex items-center gap-2">
              <span>⚠️</span>
              <span>Common Beginner Pitfalls</span>
            </h2>
            <ul class="space-y-2.5 text-xs text-slate-700 dark:text-slate-300">
              {guide.commonMistakes.map((pitfall) => (
                <li class="flex items-start gap-2">
                  <span class="text-amber-500 font-bold mt-0.5">✕</span>
                  <span>{pitfall}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Visible Domain-Specific FAQs (Matching JSON-LD FAQPage Schema) -->
        <section class="space-y-6 pt-4 border-t border-black/8 dark:border-white/8">
          <div class="max-w-2xl">
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">
              FREQUENTLY ASKED QUESTIONS
            </span>
            <h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-slate-950 dark:text-white tracking-tight">
              Common Questions About This Roadmap
            </h2>
          </div>

          <div class="space-y-4">
            {guide.faqs.map((faq) => (
              <details class="hairline-card p-5 rounded-2xl group transition-colors">
                <summary class="font-sans text-base font-bold text-slate-950 dark:text-white cursor-pointer list-none flex items-center justify-between gap-4">
                  <span>{faq.question}</span>
                  <span class="font-mono text-xs text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="pt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-black/5 dark:border-white/5 mt-3">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>

      </div>
    </article>
  )}

  <!-- Explore All Engineering Branches Section -->
  <section class="border-t border-black/8 dark:border-white/8 bg-[var(--bg-primary)] py-16 transition-colors">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">ALL DISCIPLINES</span>
          <h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-slate-950 dark:text-white tracking-tight">
            Explore other engineering branches 🧭
          </h2>
        </div>
        <a 
          href="/roadmaps" 
          class="font-mono text-xs text-sky-600 dark:text-sky-400 font-semibold hover:underline flex items-center gap-1"
        >
          <span>View All 26 Roadmaps Directory</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {allBranches.filter(b => b.fullRoadmapSlug !== roadmap.slug).map((branch) => {
          const href = branch.hasFullRoadmap ? `/roadmaps/${branch.fullRoadmapSlug}` : `/roadmaps/overview/${branch.slug}`;
          return (
            <a
              href={href}
              class="flex items-center gap-2.5 rounded-xl border border-black/8 dark:border-white/8 bg-white/60 dark:bg-white/5 p-3 hover:border-sky-500/40 hover:shadow-xs transition-all no-underline group"
            >
              <span class="text-xl shrink-0 group-hover:scale-110 transition-transform">{branch.emoji}</span>
              <div class="min-w-0 flex-1">
                <div class="font-sans text-xs font-bold text-slate-950 dark:text-white truncate group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                  {branch.name}
                </div>
                <div class="font-mono text-[10px] text-slate-400 dark:text-slate-500 capitalize truncate">
                  {branch.category}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
